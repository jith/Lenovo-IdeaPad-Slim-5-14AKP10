[Unit]
# P1 belt-and-braces (2026-08-02). The modprobe.d option alone was MEASURED
# NOT to take effect on this system: /etc/modprobe.d/speaker-dsp-powersave.conf
# is present and correct, `modprobe --showconfig` reports
# "options snd_hda_intel power_save=15", snd_hda_intel is NOT in the initramfs,
# no udev rule or other modprobe.d file touches the parameter, and no power
# daemon is running (tlp/power-profiles-daemon/thermald all inactive) - yet
# after a reboot the live value came back as 1, the kernel default.
# Writing the value directly is the reliable path. Verified that the written
# value holds: it survives 5 s idle and a full pipewire restart, so nothing is
# fighting it at runtime - the failure is purely at module-load time.
# The modprobe.d file is kept as well; it is correct and costs nothing.
Description=HDA codec idle timeout for the speaker DSP (P1)
Documentation=https://github.com/jith/Lenovo-IdeaPad-Slim-5-14AKP10
After=sound.target
Wants=sound.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Wait (bounded) for the module rather than assuming After=sound.target has
# already brought it up - that ordering is not a hard guarantee, and an early
# run would otherwise no-op. Fail LOUDLY if the parameter never appears: a
# silent no-op is what made the original modprobe.d approach look shipped when
# it was not. `systemctl status speaker-dsp-powersave` then shows the problem.
ExecStart=/bin/sh -c 'P=/sys/module/snd_hda_intel/parameters/power_save; \
  n=0; while [ ! -w "$P" ] && [ $n -lt 40 ]; do sleep 0.25; n=$((n+1)); done; \
  if [ -w "$P" ]; then echo 15 > "$P"; \
  else echo "power_save not writable after 10s - snd_hda_intel not loaded?" >&2; exit 1; fi'

[Install]
WantedBy=multi-user.target
