#!/bin/sh
# Switch the external output between the tuned virtual sink and the raw device,
# and keep the raw device's PCM at 100%. Mirrors speaker-dsp, which does the
# same job for the built-in speaker. No sudo required.
#
#   external-dsp on      External (Tuning), the six-stage chain
#   external-dsp off     bypass the DSP, staying on the same device
#   external-dsp ab      toggle, carrying the level across
#   external-dsp unity   set the device PCM to 100%, which the chain assumes
#   external-dsp devices list the connected external devices
#   external-dsp device N pick one of them by number or name
#   external-dsp status  which one is active, and what it is pointed at
#   external-dsp level N set the listening level, 0-100

if [ "$(id -u)" = "0" ] && [ -n "${SUDO_UID:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

DSP=effect_input.external-tuning
INT=effect_input.speaker-tuning

# The mirror of the guard in speaker-dsp: 'off' and 'ab' mean "bypass the DSP
# on what I am listening to". If the built-in speaker is the active output,
# that is speaker-dsp's job -- switching to the external device here would move
# the sound to a different physical device.
# Bypass IN PLACE rather than by switching the default sink to the raw device.
# The raw devices are hidden from GNOME, so making one the default meant GNOME's
# picker fell back to the first sink it could see -- Speaker (Tuning) -- and the
# sound jumped to the built-in speaker. Reported and reproduced 20 Aug 2026.
#
# Staying on External (Tuning) keeps the default sink visible and stable, and
# has a second advantage: the sink's volume is applied BEFORE the graph, so
# leaving it alone means tuned and bypassed are heard at the same level without
# any level-carrying arithmetic.
#
# X2 and X4 are neutralised, NOT disabled. Setting x2mbc:enabled = 0 drops GOTT
# to its dry path, and this chain runs g_dry = 0.0 / g_wet = 1.0, so "disabled"
# cost 12 dB rather than being transparent -- measured 20 Aug 2026. Raising the
# thresholds to full scale leaves both plugins in circuit doing nothing, which
# is what transparent actually means here. X1 and X3 are pushed out of band
# because a builtin biquad has no enable control.
filter_id() {
    pw-dump 2>/dev/null | python3 -c "
import json,sys
for o in json.load(sys.stdin):
    p=(o.get('info') or {}).get('props') or {}
    if p.get('node.name')=='effect_input.external-tuning': print(o['id']); break
"
}

set_bypass() {
    _id=$(filter_id)
    [ -n "$_id" ] || { echo "External (Tuning) not loaded" >&2; return 1; }
    if [ "$1" = "on" ]; then
        pw-cli set-param "$_id" Props '{ params = [
            "x2mbc:td_1" 1.0 "x2mbc:td_2" 1.0 "x2mbc:td_3" 1.0 "x2mbc:td_4" 1.0
            "x4brick:th" 1.0
            "x1hp_l:Freq" 5.0 "x1hp_r:Freq" 5.0
            "x3lp_l:Freq" 24000.0 "x3lp_r:Freq" 24000.0 ] }' >/dev/null 2>&1
    else
        pw-cli set-param "$_id" Props '{ params = [
            "x2mbc:td_1" 0.50 "x2mbc:td_2" 0.50 "x2mbc:td_3" 0.45 "x2mbc:td_4" 0.35
            "x4brick:th" 0.8414
            "x1hp_l:Freq" 30.0 "x1hp_r:Freq" 30.0
            "x3lp_l:Freq" 20000.0 "x3lp_r:Freq" 20000.0 ] }' >/dev/null 2>&1
    fi
}

# Bypass is a live control change, so it leaves no trace in any config file and
# does not survive a restart. Recorded here so status can report it.
# Cap the device. This speaker is uncomfortably loud at 100%, and the level now
# lives here rather than on the virtual sink, so an accidental full-scale set is
# a real hazard rather than a slider position. Override with the environment
# variable if a quieter device is ever used.
MAX_LEVEL=${EXTERNAL_DSP_MAX_LEVEL:-60}

STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}
BYPASS_FLAG=$STATE_DIR/external-dsp.bypassed

internal_is_active() {
    [ "$(pactl get-default-sink 2>/dev/null)" = "$INT" ] || return 1
    command -v speaker-dsp >/dev/null 2>&1
}

usage() {
    echo "usage: external-dsp {generate|on|off|ab|status|unity|level N|devices|device N}" >&2
    exit 2
}

# The raw device is whatever 52-external-target.lua currently points the chain
# at, so read it from the graph rather than hardcoding a device that may not be
# connected. Falls back to the highest-priority non-internal sink when the
# chain is unlinked.
raw_device() {
    _r=$(pw-link -l 2>/dev/null \
        | grep -A1 'effect_output\.external-tuning:output_FL' \
        | tail -1 | sed 's/^ *|-> *//; s/:playback_.*//; s/^ *//')
    case "$_r" in
        alsa_output*|bluez_output*) echo "$_r"; return 0 ;;
    esac
    pactl list sinks short | awk '$2 ~ /^(alsa_output|bluez_output)/ &&
        $2 !~ /HiFi__Speaker__sink/ { print $2; exit }'
}

volume_pct() {
    pactl get-sink-volume "$1" 2>/dev/null \
        | awk -F'/' '/Volume:/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

# The chain is tuned expecting the device at unity, exactly as the internal
# chain is. Anything else silently changes the gain structure the limiter was
# sized against, and nothing downstream measures it -- captures are taken ahead
# of this control. Listening level belongs on the virtual sink instead, where
# 'level' puts it.
# Warn, do not force. Forcing 100% here made the speaker jump to full output
# every time the DSP was switched, which is hostile on a loud device. This
# matches speaker-dsp, which warns about the same drift on the built-in speaker
# rather than overriding a level the listener chose. 'external-dsp unity' sets
# it deliberately.
# The pre-graph sink is the one that must stay at unity now: anything less and
# the chain stops seeing full scale and stops working. The device is where the
# level belongs, so it is deliberately NOT pinned.
pin_pregraph_unity() {
    _v=$(volume_pct "$DSP")
    [ "$_v" = "100" ] && return 0
    pactl set-sink-volume "$DSP" 100% 2>/dev/null && \
        echo "note: External (Tuning) was at ${_v}% -- that sits BEFORE the graph and"
        echo "      switches the DSP off. Restored to 100%; set loudness with"
        echo "      'external-dsp level N'."
}

case "${1:-status}" in
    on|dsp|tuning)
        pin_pregraph_unity
        set_bypass off && rm -f "$BYPASS_FLAG"
        pactl set-default-sink "$DSP" && \
            echo "EXTERNAL DSP - External (Tuning) is the default output"
        ;;
    off|raw)
        if internal_is_active; then
            echo "note: the built-in speaker is the active output, so bypassing THAT."
            echo "      Use 'external-dsp on' to move to the external device instead."
            exec speaker-dsp off
        fi
        set_bypass on && {
            : > "$BYPASS_FLAG"
            echo "BYPASS - External (Tuning) is passing through, same device, same level"
        }
        ;;
    ab)
        if internal_is_active; then
            echo "note: the built-in speaker is the active output, so toggling THAT."
            exec speaker-dsp ab
        fi
        if [ -f "$BYPASS_FLAG" ]; then exec "$0" on; else exec "$0" off; fi
        ;;
    level)
        [ -n "${2:-}" ] || usage
        _n=$2
        case "$_n" in *[!0-9]*) echo "level must be a whole number" >&2; exit 2 ;; esac
        if [ "$_n" -gt "$MAX_LEVEL" ]; then
            echo "capping at ${MAX_LEVEL}% -- this speaker is too loud above that."
            echo "raise the ceiling with EXTERNAL_DSP_MAX_LEVEL=<n> if you mean it."
            _n=$MAX_LEVEL
        fi
        _d=$(raw_device)
        [ -n "$_d" ] || { echo "no external device connected" >&2; exit 1; }
        pin_pregraph_unity
        pactl set-sink-volume "$_d" "${_n}%" && \
            echo "level: ${_n}% (on the device, after the graph)"
        ;;
    unity)
        pin_pregraph_unity
        echo "External (Tuning) pre-graph level: $(volume_pct "$DSP")% (must be 100)"
        echo "set loudness with: external-dsp level N"
        ;;
    generate)
        # One tuned sink per connected device, written to the user's own conf.d
        # so no sudo is needed. PipeWire loads filter chains at startup, and
        # modules loaded at runtime with pw-cli die with the client (verified),
        # so a new device needs this re-run and a restart -- there is no way to
        # conjure a chain on hotplug without a process that stays running.
        _gen=$(command -v gen-external-chains.py || echo \
            /home/sreejith/speaker-dsp/files/gen-external-chains.py)
        _d=${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d
        mkdir -p "$_d"
        _tmp=$(mktemp) || exit 1
        if ! python3 "$_gen" "$_tmp"; then rm -f "$_tmp"; exit 1; fi
        # Never leave a half-written config in place: PipeWire refuses to start
        # at all if a chain fails to parse, taking every sink with it.
        if ! grep -q "libpipewire-module-filter-chain" "$_tmp"; then
            echo "generator produced nothing usable; leaving config alone" >&2
            rm -f "$_tmp"; exit 1
        fi
        mv "$_tmp" "$_d/52-external-tuning.conf"
        chmod 644 "$_d/52-external-tuning.conf"
        echo "wrote $_d/52-external-tuning.conf"
        grep -c "libpipewire-module-filter-chain" "$_d/52-external-tuning.conf" \
            | sed 's/^/chains: /'
        echo "restarting pipewire..."
        systemctl --user restart pipewire pipewire-pulse wireplumber
        sleep 4
        pactl list sinks short | awk '$2 ~ /^effect_input/ { print "  " $2 }'
        ;;
    devices)
        _cur=$(raw_device)
        pactl list sinks short | awk '$2 ~ /^(alsa_output|bluez_output)/ &&
            $2 !~ /HiFi__Speaker__sink/ { print $2 }' | nl -w2 -s'  ' | \
        while read -r _n _name; do
            _mark="  "
            [ "$_name" = "$_cur" ] && _mark="->"
            _desc=$(pactl list sinks | awk -v n="$_name" '
                $1=="Name:" && $2==n { found=1 }
                found && $1=="Description:" { $1=""; sub(/^ /,""); print; exit }')
            echo "$_mark $_n  ${_desc:-$_name}"
        done
        ;;
    device)
        [ -n "${2:-}" ] || usage
        _list=$(pactl list sinks short | awk '$2 ~ /^(alsa_output|bluez_output)/ &&
            $2 !~ /HiFi__Speaker__sink/ { print $2 }')
        # Match on the DESCRIPTION as well as the node name. A Bluetooth node is
        # named bluez_output.F0:BE:25:17:71:00 -- the make and model live only
        # in the description, so 'external-dsp device oppo' matched nothing and
        # failed silently.
        case "$2" in
            [0-9]*) _pick=$(echo "$_list" | sed -n "${2}p") ;;
            *)      _pick=$(echo "$_list" | while read -r _n; do
                        _dsc=$(pactl list sinks | awk -v n="$_n" '
                            $1=="Name:" && $2==n { f=1 }
                            f && $1=="Description:" { $1=""; sub(/^ /,""); print; exit }')
                        case "$_n $_dsc" in
                            *[Nn]"$2"*|*"$2"*) echo "$_n"; break ;;
                        esac
                        echo "$_n $_dsc" | grep -qi -- "$2" && { echo "$_n"; break; }
                    done | head -1) ;;
        esac
        [ -n "$_pick" ] || { echo "no such device: $2" >&2; echo "try: external-dsp devices" >&2; exit 1; }
        _oid=$(pw-dump 2>/dev/null | python3 -c "
import json,sys
for o in json.load(sys.stdin):
    p=(o.get('info') or {}).get('props') or {}
    if p.get('node.name')=='effect_output.external-tuning': print(o['id']); break
")
        [ -n "$_oid" ] || { echo "External (Tuning) not loaded" >&2; exit 1; }
        pw-metadata "$_oid" target.object "$_pick" >/dev/null 2>&1
        # Remembered across restarts by 52-external-target.lua, which reads this
        # file. No login service: the script already runs when the graph is
        # rebuilt, and it can check the device is actually present first.
        _sd=${XDG_STATE_HOME:-$HOME/.local/state}/external-dsp
        mkdir -p "$_sd" && echo "$_pick" > "$_sd/device"
        sleep 1
        echo "External (Tuning) -> $_pick"
        echo "note: level is per-device; set it with 'external-dsp level N'."
        ;;
    status)
        _cur=$(pactl get-default-sink) || exit $?
        _d=$(raw_device)
        case "$_cur" in
            "$DSP") if [ -f "$BYPASS_FLAG" ]; then
                        echo "state: External (Tuning), BYPASSED (pass-through)"
                    else
                        echo "state: External (Tuning), six-stage chain"
                    fi ;;
            "$_d")  echo "state: raw device, no processing" ;;
            "$INT") echo "state: built-in speaker -- run 'speaker-dsp status'" ;;
            *)      echo "state: other output ($_cur)" ;;
        esac
        echo "device: ${_d:-none connected}"
        [ -n "$_d" ] && echo "  level (device, after the graph): $(volume_pct "$_d")%   (max $MAX_LEVEL)"
        _pg=$(volume_pct "$DSP")
        if [ "$_pg" = "100" ]; then
            echo "  pre-graph sink: 100%   (correct -- chain sees full scale)"
        else
            echo "  pre-graph sink: ${_pg}%   WRONG -- the DSP is being bypassed by volume."
            echo "                        run 'external-dsp unity'"
        fi
        ;;
    *) usage ;;
esac
