#!/bin/sh
# Control the External (Tuning) chains -- the six-stage DSP that every output
# except the built-in speaker is played through. Mirrors speaker-dsp, which does
# the same job for the built-in speaker. No sudo required.
#
#   external-dsp on      the six-stage chain processes
#   external-dsp off     bypass it, staying on the same device at the same level
#   external-dsp ab      toggle between the two
#   external-dsp unity   put every chain input back to 100%, which it assumes
#   external-dsp devices list the connected external devices
#   external-dsp device N pick one of them by number or name
#   external-dsp status  what is playing, through what, at what level
#   external-dsp gott    how hard the compressor works -- the density ladder
#   external-dsp eq      show or set the voicing, live, per class of device
#   external-dsp level N set the listening level, 0-100
#
# HOW THE ROUTING WORKS, because every subcommand here depends on it. GNOME
# lists the REAL devices -- "OPPO Enco Buds", "Creative Stage Mini" -- and the
# chains are hidden. So the default sink is the device itself, and the chain is
# spliced in behind it: 52-external-target.lua moves each app stream into
# effect_input.tuned-<class>, whose output feeds the selected device.
#
# That is why nothing here switches the default sink to a virtual sink. It used
# to, back when a single "External (Tuning)" entry was what GNOME showed, and
# every remnant of that model was broken by the change: this script drove
# effect_input.external-tuning, a sink that no longer exists, so 'on' failed with
# "No such entity" and 'status' reported "raw device, no processing" while the
# chain was in fact processing. Reported from real use 21 Aug 2026.

if [ "$(id -u)" = "0" ] && [ -n "${SUDO_UID:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

INT=effect_input.speaker-tuning
INT_RAW=alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink

# Cap the device. This speaker is uncomfortably loud at 100%, and the level
# lives on the device rather than on a virtual sink, so an accidental full-scale
# set is a real hazard rather than a slider position. Override with the
# environment variable if a quieter device is ever used.
MAX_LEVEL=${EXTERNAL_DSP_MAX_LEVEL:-60}

# Bypass is a live control change, so it leaves no trace in any config file and
# does not survive a restart. Recorded here so status can report it.
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}
BYPASS_FLAG=$STATE_DIR/external-dsp.bypassed

usage() {
    echo "usage: external-dsp {on|off|ab|status|gott|eq|unity|level N|devices|device N|generate}" >&2
    echo "  gott [PRESET]           protect | gentle | medium | dense | crush" >&2
    echo "  eq                      show the voicing for the current device" >&2
    echo "  eq BAND dB [BAND dB..]  bass | mid | presence | treble, -12..+12" >&2
    echo "  eq flat                 every band back to 0" >&2
    echo "  eq preset NAME          a starting curve; 'eq presets' lists them" >&2
    exit 2
}

# Every loaded chain, one line each:  <class> <input-node-id> <pattern> <description>
#
# The two halves of a chain carry different things. The Props that 'off'
# neutralises live on the INPUT node; speaker-dsp.match, naming the devices the
# chain serves, lives on the OUTPUT node. They pair by the class suffix.
chains() {
    pw-dump 2>/dev/null | python3 -c "
import json, sys
ins, pats = {}, {}
for o in json.load(sys.stdin):
    p = (o.get('info') or {}).get('props') or {}
    n = p.get('node.name') or ''
    if n.startswith('effect_input.tuned-'):
        ins[n[19:]] = (o['id'], p.get('node.description') or n)
    elif n.startswith('effect_output.tuned-'):
        pats[n[20:]] = p.get('speaker-dsp.match') or ''
for cls in sorted(ins):
    nid, desc = ins[cls]
    print(cls, nid, pats.get(cls) or '-', desc)
"
}

# Which chain serves a given device. This repeats the matching that
# 52-external-target.lua does for real; the patterns are Lua patterns, and the
# generator only ever emits an anchored literal prefix, so turning Lua's '%'
# escape into a backslash is exact for everything it produces.
chain_for() {
    chains | python3 -c "
import re, sys
dev = sys.argv[1]
for line in sys.stdin:
    cls, nid, pat, desc = line.rstrip('\n').split(' ', 3)
    if pat != '-' and re.match(pat.replace('%', '\\\\'), dev):
        print(cls, nid, desc)
        break
" "$1"
}

volume_pct() {
    pactl get-sink-volume "$1" 2>/dev/null \
        | awk -F'/' '/Volume:/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

description_of() {
    pactl list sinks 2>/dev/null | awk -v n="$1" '
        $1=="Name:" && $2==n { f=1 }
        f && $1=="Description:" { $1=""; sub(/^ /,""); print; exit }'
}

external_sinks() {
    pactl list sinks short 2>/dev/null | awk '$2 ~ /^(alsa_output|bluez_output)/ &&
        $2 !~ /HiFi__Speaker__sink/ { print $2 }'
}

internal_is_active() {
    case "$(pactl get-default-sink 2>/dev/null)" in
        "$INT"|"$INT_RAW") ;;
        *) return 1 ;;
    esac
    command -v speaker-dsp >/dev/null 2>&1
}

# The device being listened to: the default sink, when that is a real external
# device. Falls back to the first connected one so 'level' and 'devices' still
# have something to talk about while the built-in speaker is selected.
active_device() {
    _d=$(pactl get-default-sink 2>/dev/null)
    case "$_d" in
        alsa_output*|bluez_output*)
            [ "$_d" = "$INT_RAW" ] || { echo "$_d"; return 0 ; } ;;
    esac
    external_sinks | head -1
}

# How many app streams are inside the chain, and how many are playing straight
# into the device untuned. The second number is the failure this whole design
# exists to prevent -- it means the stream was not redirected -- so status
# reports it rather than leaving it to be noticed by ear.
census() {
    pactl list sink-inputs 2>/dev/null | awk -v c="$1" -v d="$2" '
        function flush() {
            if (sink == "") return
            if (sink == c) inside++
            else if (sink == d && nm !~ /effect_output/) raw++
            sink = ""
        }
        /^Sink Input/ { flush(); nm = "" }
        $1 == "Sink:" { sink = $2 }
        $1 == "node.name" { nm = $3 }
        END { flush(); print inside+0, raw+0 }'
}

# X2 and X4 are neutralised, NOT disabled. Setting x2mbc:enabled = 0 drops GOTT
# to its dry path, and this chain runs g_dry = 0.0 / g_wet = 1.0, so "disabled"
# cost 12 dB rather than being transparent -- measured 20 Aug 2026. Raising the
# thresholds to full scale leaves both plugins in circuit doing nothing, which
# is what transparent actually means here. X1 and X3 are pushed out of band
# because a builtin biquad has no enable control.
#
# Applied to EVERY chain, not just the one serving the current device: the
# chains are per class, so bypassing only the active one meant switching from
# the earbuds to the USB speaker silently turned the DSP back on mid-comparison.
set_bypass() {
    _ids=$(chains | awk '{ print $2 }')
    [ -n "$_ids" ] || { echo "no External (Tuning) chain is loaded" >&2; return 1; }
    for _id in $_ids; do
        if [ "$1" = "on" ]; then
            # The UPWARD half and the makeup have to go too, not just the
            # downward thresholds. Raising td alone stops downward compression
            # and leaves ru and mk applied -- and bypass also neutralises X4, so
            # a 'crush' preset bypassed this way measured -5.33 LUFS against a
            # correct -10.82 and clipped at +0.049 dBTP. A bypass that is 5.5 LU
            # loud and clipping is not a bypass, and it would have been the
            # first thing to happen after choosing any preset.
            pw-cli set-param "$_id" Props '{ params = [
                "x2mbc:td_1" 1.0 "x2mbc:td_2" 1.0 "x2mbc:td_3" 1.0 "x2mbc:td_4" 1.0
                "x2mbc:ru_1" 1.0 "x2mbc:ru_2" 1.0 "x2mbc:ru_3" 1.0 "x2mbc:ru_4" 1.0
                "x2mbc:mk_1" 1.0 "x2mbc:mk_2" 1.0 "x2mbc:mk_3" 1.0 "x2mbc:mk_4" 1.0
                "x4brick:th" 1.0
                "x1hp_l:Freq" 5.0 "x1hp_r:Freq" 5.0
                "x3lp_l:Freq" 24000.0 "x3lp_r:Freq" 24000.0 ] }' >/dev/null 2>&1
        else
            pw-cli set-param "$_id" Props '{ params = [
                "x4brick:th" 0.8414
                "x1hp_l:Freq" 30.0 "x1hp_r:Freq" 30.0
                "x3lp_l:Freq" 20000.0 "x3lp_r:Freq" 20000.0 ] }' >/dev/null 2>&1
            # The thresholds belong to whichever density preset is chosen, so
            # they are restored from that rather than from the shipped values.
            # Hardcoding them here meant 'off' then 'on' silently reset a
            # chosen preset back to the inaudible one.
            gott_apply "$_id" "$(gott_current)"
        fi
    done
}

# A chain's own input sink is applied BEFORE the graph, so anything below 100%
# starves the compressor and limiter of the level they were sized against and
# quietly switches the tuning off. The listening level belongs on the device,
# after the graph, which is where 'level' puts it. So this one is pinned and
# the device's is deliberately not.
pin_pregraph_unity() {
    for _c in $(chains | awk '{ print $1 }'); do
        _sink=effect_input.tuned-$_c
        _v=$(volume_pct "$_sink")
        [ "$_v" = "100" ] && continue
        if pactl set-sink-volume "$_sink" 100% 2>/dev/null; then
            echo "note: $_sink was at ${_v:-?}% -- that sits BEFORE the graph, so it"
            echo "      was switching the DSP off. Restored to 100%; set the"
            echo "      listening level with 'external-dsp level N'."
        fi
    done
}



# -- stage X2, GOTT: how hard it works ---------------------------------------
#
# GOTT is an UPWARD AND DOWNWARD compressor -- that is the whole point of the
# plugin -- and the shipped chain had the upward half switched off. ru_* = 1.0
# is the port's MINIMUM, a 1:1 upward ratio, which is "do nothing". The plugin's
# own defaults are ru = 4.0 and rd = 6.0; the chain ran ru = 1.0 and rd = 2.0
# with every makeup pinned at unity. Measured contribution on programme: 0.12 LU.
# That is why the chain was inaudible.
#
# Upward compression is what brings quiet detail up; downward tames peaks; the
# makeup turns the resulting headroom into level. Together they are the density
# the plugin is known for. Measured on 30 s of -10.7 LUFS programme:
#
#     preset     LUFS-I   LRA     THD 90 Hz   vs protect
#     protect    -11.0    11.9 LU   0.01 %      +0.0 LU     <- shipped, inaudible
#     gentle      -8.9    11.3      0.10 %      +2.1 LU
#     medium      -8.4    10.4      0.21 %      +2.6 LU
#     dense       -7.9     9.4      0.44 %      +3.1 LU
#     crush       -7.2     8.4      0.75 %      +3.8 LU
#
# Sample peak stays at -1.500 dBFS in every row: X4 holds, so none of this
# clips however hard X2 is driven.
#
# THE DISTORTION IS GOTT'S, NOT THE LIMITER'S. Checked by neutralising X4 --
# 0.76 % with it and without. It is gain modulation inside a 90 Hz period, which
# is inherent to compressing bass this hard and is the "smearing" the character
# is made of. Band-1 timing was swept to reduce it and plateaus: ta 20/tr 250
# gives 0.75 %, ta 30/tr 500 gives 0.62 %, and slower buys nothing. The
# compressing presets use 30/500 for that reason.
#
# For scale, an earbud driver's own THD at 90 Hz is typically 0.5-2 %, so
# 'dense' adds roughly what the transducer already contributes and 'crush' adds
# rather more. Pick by ear -- that is what the ladder is for.
GOTT_STATE=$STATE_DIR/external-dsp.gott

gott_preset() {
    #        ru  tu       rd  td       mk       ru4 rd4 mk4      ta1 tr1
    case "$1" in
        protect) echo "1  0.12589  2   PROTECT  1.0      1   2.5 1.0      20  250" ;;
        gentle)  echo "2  0.03162  3   0.19953  1.58489  2   3   1.25893  30  500" ;;
        medium)  echo "4  0.04467  4   0.15849  1.99526  3   4   1.41254  30  500" ;;
        dense)   echo "6  0.06310  6   0.12589  2.51189  4   5   1.58489  30  500" ;;
        crush)   echo "8  0.10000  8   0.10000  3.16228  6   6   1.77828  30  500" ;;
        *) return 1 ;;
    esac
}

gott_apply() {
    _id=$1; _name=$2
    set -- $(gott_preset "$_name") || return 1
    _ru=$1 _tu=$2 _rd=$3 _td=$4 _mk=$5 _ru4=$6 _rd4=$7 _mk4=$8 _ta=$9
    shift 9; _tr=$1
    if [ "$_td" = "PROTECT" ]; then
        # The original downward-only settings, per band, kept verbatim so
        # 'protect' is exactly the chain as it shipped.
        _p='"x2mbc:td_1" 0.50 "x2mbc:td_2" 0.50 "x2mbc:td_3" 0.45 "x2mbc:td_4" 0.35'
    else
        _p="\"x2mbc:td_1\" $_td \"x2mbc:td_2\" $_td \"x2mbc:td_3\" $_td \"x2mbc:td_4\" $_td"
    fi
    pw-cli set-param "$_id" Props "{ params = [
        \"x2mbc:ru_1\" $_ru \"x2mbc:ru_2\" $_ru \"x2mbc:ru_3\" $_ru \"x2mbc:ru_4\" $_ru4
        \"x2mbc:tu_1\" $_tu \"x2mbc:tu_2\" $_tu \"x2mbc:tu_3\" $_tu \"x2mbc:tu_4\" $_tu
        \"x2mbc:rd_1\" $_rd \"x2mbc:rd_2\" $_rd \"x2mbc:rd_3\" $_rd \"x2mbc:rd_4\" $_rd4
        $_p
        \"x2mbc:mk_1\" $_mk \"x2mbc:mk_2\" $_mk \"x2mbc:mk_3\" $_mk \"x2mbc:mk_4\" $_mk4
        \"x2mbc:ta_1\" $_ta \"x2mbc:tr_1\" $_tr ] }" >/dev/null 2>&1
}

gott_current() { cat "$GOTT_STATE" 2>/dev/null || echo protect; }

# -- stage XV, the voicing ---------------------------------------------------
#
# The other five stages protect and control, which is all that can honestly be
# done to hardware nobody has measured. This one changes the sound, so it is set
# BY EAR and ships flat: a fresh install is identical to the chain before the
# stage existed.
#
# Per CLASS of device, because that is how the chains are built -- earbuds and a
# USB speaker want different curves and get different chains, so setting one
# does not touch the other.
#
# MEASURED, so the numbers mean something. On 30 s of -10.7 LUFS programme with
# peaks at -0.1 dBFS, a +4 dB shelf or peak delivers into its own band:
#
#     band        set    delivered   bleed into neighbours
#     bass        +4     +2.10       low-mid +0.36
#     presence    +4     +2.55       top     +0.76
#     treble      +4     +1.92       presence -0.03
#
# Delivered is smaller than set because a band average is diluted by the shelf's
# own transition and by X1 removing the bottom. It is still well above the ~1 dB
# that is audible, which is the point.
#
# NO INPUT TRIM COMPENSATION, though it was built and measured first. The worry
# was that boosts would make X4 work harder and pump. Swept to +15 dB, LRA stays
# between 11.9 and 12.4 LU against 11.9 flat, and sample peak is pinned at
# -1.500 dBFS throughout -- the limiter holds without squashing. Compensating
# cost 4.7 LU of level to move the tilt by 0.12 dB, so it was removed.
EQ_BANDS="bass mid presence treble"

eq_nodes() {
    case "$1" in
        bass)     echo "xv1bass_l xv1bass_r" ;;
        mid)      echo "xv2mid_l xv2mid_r" ;;
        pres|presence) echo "xv3pres_l xv3pres_r" ;;
        treb|treble)  echo "xv4treb_l xv4treb_r" ;;
        *)        return 1 ;;
    esac
}

eq_label() {
    case "$1" in
        bass)     echo "150 Hz shelf" ;;
        mid)      echo "1 kHz" ;;
        presence) echo "3.5 kHz" ;;
        treble)   echo "8 kHz shelf" ;;
    esac
}

# Read back from the graph rather than from a state file: the graph is what is
# actually in circuit, and a live set that silently failed would otherwise be
# reported as applied.
eq_get() {
    _n=$(eq_nodes "$2" | awk '{print $1}')
    pw-cli enum-params "$1" Props 2>/dev/null \
        | grep -A1 "\"$_n:Gain\"" | tail -1 | awk '{printf "%.1f", $2}'
}

# A chain built from a config older than stage XV has no xv nodes at all, and
# eq_get would read every band as empty -- which eq_show would then print as a
# flat curve. Reporting "not voicing anything" for "cannot voice anything" is
# the worst possible answer, so check first.
eq_present() {
    pw-cli enum-params "$1" Props 2>/dev/null | grep -q '"xv1bass_l:Gain"'
}

eq_show() {
    _id=$1; _desc=$2
    echo "voicing: $_desc"
    echo
    _any=0
    for _b in $EQ_BANDS; do
        _g=$(eq_get "$_id" "$_b")
        _g=${_g:-0.0}
        case "$_g" in 0.0|-0.0) ;; *) _any=1 ;; esac
        # printf's '+' flag is numeric-only and these are strings, so the sign
        # and the bar are both built here. The bar is centred on a zero column
        # so cuts and boosts are read at a glance.
        awk -v b="$_b" -v f="$(eq_label "$_b")" -v g="$_g" 'BEGIN {
            n = g < 0 ? int(-g + 0.5) : int(g + 0.5)
            if (n > 8) n = 8
            left = ""; right = ""
            if (g < 0) { for (i = 0; i < n; i++) left = left "<" }
            else       { for (i = 0; i < n; i++) right = right ">" }
            sign = (g > 0) ? "+" : ""
            printf "  %-10s %-14s %6s dB   %8s|%s\n", b, f, sign g, left, right
        }'
    done
    [ "$_any" = "0" ] && echo "  (flat -- this chain is not voicing anything)"
    return 0
}

eq_set() {
    _id=$1; shift
    _params=""
    while [ $# -gt 0 ]; do
        _b=$1; _g=$2
        [ -n "$_g" ] || { echo "eq: '$_b' needs a value in dB" >&2; return 2; }
        _nodes=$(eq_nodes "$_b") || {
            echo "eq: no such band '$_b' -- try: $EQ_BANDS" >&2; return 2; }
        case "$_g" in
            *[!0-9.+-]*|"") echo "eq: '$_g' is not a number of dB" >&2; return 2 ;;
        esac
        # +-12 dB is not a safety limit -- the limiter holds well past it,
        # measured to +15 -- it is a typo guard. Past this it is not a voicing,
        # it is a different speaker.
        awk -v g="$_g" 'BEGIN{exit !(g>=-12 && g<=12)}' || {
            echo "eq: ${_g} dB is outside -12..+12" >&2; return 2; }
        for _n in $_nodes; do
            _params="$_params \"$_n:Gain\" $_g"
        done
        shift 2
    done
    [ -n "$_params" ] || return 2
    pw-cli set-param "$_id" Props "{ params = [$_params ] }" >/dev/null 2>&1
}

eq_preset() {
    case "$1" in
        # Cheap true-wireless earbuds are near-universally V-shaped: lifted
        # bass, recessed mids, a hot upper treble. Everything but 'flat' here
        # is some way of unbending that, and none of it is measured -- pick by
        # ear.
        flat)    echo "bass 0 mid 0 presence 0 treble 0" ;;
        vocal)   echo "bass -2 mid 2.5 presence 1.5 treble -1" ;;
        warm)    echo "bass 3 mid 0.5 presence -1.5 treble -2.5" ;;
        bright)  echo "bass -1 mid 0 presence 2.5 treble 3" ;;
        bass)    echo "bass 5 mid 0 presence 0 treble -1" ;;
        *) return 1 ;;
    esac
}

case "${1:-status}" in
    on|dsp|tuning)
        set_bypass off || exit 1
        rm -f "$BYPASS_FLAG"
        pin_pregraph_unity
        # Deliberately does NOT move the output. Switching the default sink is
        # what made 'off' throw the sound onto the built-in speaker in the old
        # model; the selection is the listener's, and on/off only decide whether
        # what they picked is processed.
        if internal_is_active; then
            echo "EXTERNAL DSP - the chains are processing again, but the built-in"
            echo "               speaker is the selected output, so you will not"
            echo "               hear the difference until you pick an external"
            echo "               device. See 'external-dsp devices'."
        else
            _d=$(active_device)
            echo "EXTERNAL DSP - six-stage chain${_d:+, into $(description_of "$_d")}"
        fi
        ;;
    off|raw)
        if internal_is_active; then
            echo "note: the built-in speaker is the active output, so bypassing THAT."
            echo "      Pick an external device first to bypass the external chain."
            exec speaker-dsp off
        fi
        set_bypass on || exit 1
        : > "$BYPASS_FLAG"
        echo "BYPASS - the chain is passing through, same device, same level"
        ;;
    ab)
        if internal_is_active; then
            echo "note: the built-in speaker is the active output, so toggling THAT."
            exec speaker-dsp ab
        fi
        if [ -f "$BYPASS_FLAG" ]; then exec "$0" on; else exec "$0" off; fi
        ;;
    level)
        [ -n "${2:-}" ] || usage
        _n=$2
        case "$_n" in *[!0-9]*) echo "level must be a whole number" >&2; exit 2 ;; esac
        if [ "$_n" -gt "$MAX_LEVEL" ]; then
            echo "capping at ${MAX_LEVEL}% -- this speaker is too loud above that."
            echo "raise the ceiling with EXTERNAL_DSP_MAX_LEVEL=<n> if you mean it."
            _n=$MAX_LEVEL
        fi
        _d=$(active_device)
        [ -n "$_d" ] || { echo "no external device connected" >&2; exit 1; }
        pin_pregraph_unity
        pactl set-sink-volume "$_d" "${_n}%" && \
            echo "level: ${_n}% on $(description_of "$_d") (after the graph)"
        ;;
    gott|density)
        shift
        if internal_is_active; then
            echo "the built-in speaker is the active output; this is the external" >&2
            echo "chain's compressor. Pick an external device first." >&2
            exit 1
        fi
        _d=$(active_device)
        [ -n "$_d" ] || { echo "no external device connected" >&2; exit 1; }
        set -- "$(chain_for "$_d")" "$@"
        _cid=$(echo "$1" | awk '{print $2}')
        _cdesc=$(echo "$1" | cut -d' ' -f3-)
        shift
        [ -n "$_cid" ] || { echo "no chain matches $_d" >&2; exit 1; }
        case "${1:-show}" in
            show)
                echo "GOTT density: $(gott_current)   on $_cdesc"
                echo
                _ru=$(pw-cli enum-params "$_cid" Props 2>/dev/null \
                        | grep -A1 '"x2mbc:ru_1"' | tail -1 | awk '{printf "%.1f", $2}')
                _mk=$(pw-cli enum-params "$_cid" Props 2>/dev/null \
                        | grep -A1 '"x2mbc:mk_1"' | tail -1 | awk '{printf "%.2f", $2}')
                echo "  upward ratio  ${_ru:-?}:1   (1.0 = upward compression OFF)"
                echo "  makeup        ${_mk:-?}x"
                echo
                echo "presets, measured on -10.7 LUFS programme:"
                echo "                LUFS-I    LRA      THD 90 Hz   vs protect"
                echo "  protect       -11.0     11.9 LU    0.01 %      +0.0 LU"
                echo "  gentle         -8.9     11.3 LU    0.10 %      +2.1 LU"
                echo "  medium         -8.4     10.4 LU    0.21 %      +2.6 LU"
                echo "  dense          -7.9      9.4 LU    0.44 %      +3.1 LU"
                echo "  crush          -7.2      8.4 LU    0.75 %      +3.8 LU"
                echo
                echo "apply with: external-dsp gott dense"
                ;;
            *)
                gott_preset "$1" >/dev/null || {
                    echo "no such preset: $1" >&2
                    echo "try: protect gentle medium dense crush" >&2; exit 2; }
                gott_apply "$_cid" "$1" || { echo "could not set GOTT" >&2; exit 1; }
                echo "$1" > "$GOTT_STATE"
                echo "GOTT density: $1   on $_cdesc"
                case "$1" in
                    protect) echo "  downward only, upward off -- inaudible by design" ;;
                    crush)   echo "  +3.8 LU louder and 3.5 LU less range than protect." ;;
                    *)       echo "  louder and denser; peak still held at -1.5 dBFS by X4." ;;
                esac
                ;;
        esac
        ;;
    eq)
        shift
        if internal_is_active; then
            echo "the built-in speaker is the active output; this voicing is for" >&2
            echo "external devices only. Pick one with 'external-dsp devices'." >&2
            exit 1
        fi
        _d=$(active_device)
        [ -n "$_d" ] || { echo "no external device connected" >&2; exit 1; }
        set -- "$(chain_for "$_d")" "$@"
        _cls=$(echo "$1" | awk '{print $1}')
        _cid=$(echo "$1" | awk '{print $2}')
        _cdesc=$(echo "$1" | cut -d' ' -f3-)
        shift
        [ -n "$_cid" ] || { echo "no chain matches $_d" >&2; exit 1; }
        eq_present "$_cid" || {
            echo "$_cdesc has no voicing stage -- it was built from a config" >&2
            echo "older than stage XV. Re-run install.sh from the repo, then:" >&2
            echo "  systemctl --user restart pipewire pipewire-pulse wireplumber" >&2
            exit 1; }
        case "${1:-show}" in
            show)
                eq_show "$_cid" "$_cdesc  ->  $(description_of "$_d")"
                echo
                echo "set with: external-dsp eq bass +3 treble -2"
                echo "presets:  external-dsp eq presets"
                ;;
            presets)
                echo "flat    no voicing at all"
                echo "vocal   unbend the V -- mids and consonants forward"
                echo "warm    weight up, treble down"
                echo "bright  air and detail up"
                echo "bass    weight up hard, treble eased"
                echo
                echo "apply with: external-dsp eq preset vocal"
                ;;
            preset)
                [ -n "${2:-}" ] || { echo "which preset? try 'external-dsp eq presets'" >&2; exit 2; }
                _p=$(eq_preset "$2") || {
                    echo "no such preset: $2 -- try 'external-dsp eq presets'" >&2; exit 2; }
                eq_set "$_cid" $_p || exit $?
                echo "preset '$2' applied to $_cdesc"
                echo
                eq_show "$_cid" "$_cdesc"
                ;;
            flat)
                eq_set "$_cid" bass 0 mid 0 presence 0 treble 0 || exit $?
                echo "flat -- $_cdesc is not voicing anything"
                ;;
            *)
                eq_set "$_cid" "$@" || exit $?
                eq_show "$_cid" "$_cdesc"
                ;;
        esac
        # Live only. PipeWire reads filter-chain controls from config at startup
        # and nothing runs at login to reapply them, so this is lost on restart
        # -- deliberately, while a curve is being auditioned. Once one is chosen
        # it belongs in the template as that class's shipped default, which
        # survives everything and needs no machinery.
        ;;
    unity)
        pin_pregraph_unity
        chains | while read -r _c _id _pat _desc; do
            printf '  %-30s %4s%%  (must be 100)\n' \
                "effect_input.tuned-$_c" "$(volume_pct "effect_input.tuned-$_c")"
        done
        echo "set the listening level with: external-dsp level N"
        ;;
    devices)
        _cur=$(pactl get-default-sink 2>/dev/null)
        _n=0
        external_sinks | while read -r _name; do
            _n=$((_n + 1))
            _mark="  "
            [ "$_name" = "$_cur" ] && _mark="->"
            _ch=$(chain_for "$_name" | cut -d' ' -f3-)
            printf '%s %d  %-28s %s\n' "$_mark" "$_n" \
                "$(description_of "$_name")" "${_ch:-NO CHAIN MATCHES}"
        done
        [ -n "$(external_sinks)" ] || echo "no external device connected"
        ;;
    device)
        [ -n "${2:-}" ] || usage
        _list=$(external_sinks)
        # Match on the DESCRIPTION as well as the node name. A Bluetooth node is
        # named bluez_output.F0:BE:25:17:71:00 -- the make and model live only
        # in the description, so 'external-dsp device oppo' matched nothing and
        # failed silently.
        case "$2" in
            [0-9]*) _pick=$(echo "$_list" | sed -n "${2}p") ;;
            *)      _pick=$(echo "$_list" | while read -r _name; do
                        echo "$_name $(description_of "$_name")" \
                            | grep -qi -- "$2" && { echo "$_name"; break; }
                    done | head -1) ;;
        esac
        [ -n "$_pick" ] || { echo "no such device: $2" >&2
                             echo "try: external-dsp devices" >&2; exit 1; }
        # Selecting the DEVICE, not a chain: 52-external-target.lua sees the
        # default sink change and moves the streams into the matching chain.
        # This is exactly what picking it in GNOME does.
        pactl set-default-sink "$_pick" || exit 1
        sleep 1
        echo "output: $(description_of "$_pick")"
        _ch=$(chain_for "$_pick" | cut -d' ' -f3-)
        echo "chain:  ${_ch:-NONE -- this device matches no chain, it will play untuned}"
        echo "note: level is per-device; set it with 'external-dsp level N'."
        ;;
    generate)
        # The chains are per CLASS now -- one for Bluetooth, one for wired -- so
        # a newly paired device needs nothing regenerated; it matches an existing
        # chain the moment it appears. This is only for after the template
        # changes, and install.sh already does it.
        #
        # It must NOT write a second copy into the user's conf.d. PipeWire MERGES
        # conf.d rather than shadowing it, so a user copy alongside the installed
        # one loads both and every sink appears twice -- reported and reproduced
        # 20 Aug 2026.
        if [ -f /etc/pipewire/pipewire.conf.d/52-external-tuning.conf ]; then
            echo "the chains are installed system-wide already:"
            echo "  /etc/pipewire/pipewire.conf.d/52-external-tuning.conf"
            echo
            echo "Writing a second copy here would not replace it -- PipeWire"
            echo "merges conf.d, so both would load and every sink would appear"
            echo "twice. To pick up a template change, re-run install.sh."
            exit 1
        fi
        _gen=$(command -v gen-external-chains.py || echo \
            /home/sreejith/speaker-dsp/files/gen-external-chains.py)
        _d=${XDG_CONFIG_HOME:-$HOME/.config}/pipewire/pipewire.conf.d
        mkdir -p "$_d"
        _tmp=$(mktemp) || exit 1
        if ! python3 "$_gen" "$_tmp"; then rm -f "$_tmp"; exit 1; fi
        # Never leave a half-written config in place: PipeWire refuses to start
        # at all if a chain fails to parse, taking every sink with it.
        if ! grep -q "libpipewire-module-filter-chain" "$_tmp"; then
            echo "generator produced nothing usable; leaving config alone" >&2
            rm -f "$_tmp"; exit 1
        fi
        mv "$_tmp" "$_d/52-external-tuning.conf"
        chmod 644 "$_d/52-external-tuning.conf"
        echo "wrote $_d/52-external-tuning.conf"
        echo "restarting pipewire..."
        systemctl --user restart pipewire pipewire-pulse wireplumber
        sleep 4
        pactl list sinks short | awk '$2 ~ /^effect_input/ { print "  " $2 }'
        ;;
    status)
        if internal_is_active; then
            echo "state: built-in speaker -- run 'speaker-dsp status'"
            exit 0
        fi
        _d=$(active_device)
        if [ -z "$_d" ]; then
            echo "state: no external device connected"
            exit 0
        fi
        set -- $(chain_for "$_d")
        _cls=$1; _cid=$2
        if [ -z "$_cls" ]; then
            echo "state: $(description_of "$_d") -- NO CHAIN MATCHES, playing untuned"
            exit 0
        fi
        _desc=$(chains | awk -v c="$_cls" '$1==c { $1=""; $2=""; $3=""; sub(/^ +/,""); print }')
        if [ -f "$BYPASS_FLAG" ]; then
            echo "state: $_desc -- BYPASSED (pass-through)"
        else
            echo "state: $_desc -- six-stage chain, GOTT '$(gott_current)'"
        fi
        echo "device: $(description_of "$_d")"
        echo "        $_d"
        printf '  level (device, after the graph):  %4s%%   (max %s)\n' \
            "$(volume_pct "$_d")" "$MAX_LEVEL"
        _pg=$(volume_pct "effect_input.tuned-$_cls")
        if [ "$_pg" = "100" ]; then
            printf '  chain input (before the graph):   %4s%%   correct\n' "$_pg"
        else
            printf '  chain input (before the graph):   %4s%%   WRONG -- this bypasses\n' \
                "${_pg:-?}"
            echo "                                          the DSP by volume."
            echo "                                          run 'external-dsp unity'"
        fi
        _dev_id=$(pactl list sinks short | awk -v n="$_d" '$2==n { print $1; exit }')
        set -- $(census "$_cid" "$_dev_id")
        printf '  streams in the chain:             %4s\n' "$1"
        if [ "${2:-0}" -gt 0 ]; then
            printf '  streams bypassing it:             %4s   NOT REDIRECTED --\n' "$2"
            echo "                                          52-external-target.lua"
            echo "                                          is not running"
        fi
        ;;
    *) usage ;;
esac
