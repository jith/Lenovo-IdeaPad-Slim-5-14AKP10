#!/bin/sh
# speaker-loudness-follow: make the loudness contour track the volume knob
# (Apple-style volume-aware EQ). Watches the DSP sink's volume and updates
# the loud_comp node inside the filter graph at runtime.
#
# Math: PipeWire applies sink volume BEFORE the graph with a cubic taper
# (measured on this machine: 50% -> -18 dB, 25% -> -36 dB), so
#   attenuation A(dB) = 60 * log10(100 / vol%)
# loud_comp "volume" gets the listening level (-A) which selects the ISO 226
# contour AND attenuates; "input" gets 10^(A/20) as makeup so the signal is
# not attenuated twice (the sink already did it). Net effect: 1 kHz unity,
# bass/treble raised by the equal-loudness delta for that listening level.
# A is capped at 30 dB: deeper contours pump the psycho-bass branch too hard.
#
# S2 (2026-07-23): level-aware bass extension (software stand-in for a smart
# amp's excursion model). The 270 Hz excursion-protection HP corner is a
# WORST-CASE (100% volume) figure; the cubic taper means lower knob values
# drive the cone far less, so the corner can safely drop and let real
# 170-270 Hz fundamentals through. Measured basis (2026-07-23 stepped tones):
# THD at 150-220 Hz is 4-8% at -5 dBFS drive and falls with level; at <=60%
# knob the taper alone is >=13 dB down. Map (conservative):
#   >=75% -> 270 Hz | 60-74% -> 240 | 45-59% -> 210 | 30-44% -> 190 | <30% -> 170
# The corner is set in the same pw-cli call as the contour, so it always
# tracks the knob; conf default stays 270 (safe if this daemon is down).

SINK="${SPEAKER_DSP_SINK:-effect_input.speaker-tuning}"
LAST=""
# decimal points must be '.' in the pw-cli pod regardless of user locale
LC_ALL=C
export LC_ALL

apply() {
    V=$(pactl get-sink-volume "$SINK" 2>/dev/null \
        | sed -n 's/.*front-left:[^/]*\/ *\([0-9]*\)%.*/\1/p')
    [ -n "$V" ] || return 0
    [ "$V" -gt 100 ] && V=100
    [ "$V" -lt 2 ] && V=2
    [ "$V" = "$LAST" ] && return 0
    LAST=$V
    set -- $(awk -v v="$V" 'BEGIN {
        a = 60 * log(100 / v) / log(10)
        if (a > 30) a = 30
        printf "%.1f %.4f", a, 10 ^ (a / 20)
    }')
    A=$1; IG=$2
    # level-aware bass: HP corner follows the knob (see header)
    if   [ "$V" -ge 75 ]; then HPF=270.0
    elif [ "$V" -ge 60 ]; then HPF=240.0
    elif [ "$V" -ge 45 ]; then HPF=210.0
    elif [ "$V" -ge 30 ]; then HPF=190.0
    else                       HPF=170.0
    fi
    pw-cli s "$SINK" Props \
        "{ params = [ \"loud:volume\" -$A \"loud:input\" $IG \"hp_l:Freq\" $HPF \"hp_r:Freq\" $HPF ] }" \
        >/dev/null 2>&1 || LAST=""   # retry on next event if node not up yet
}

# wait for the sink, apply the current volume once, then follow changes
i=0
until pactl get-sink-volume "$SINK" >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -gt 60 ] && exit 1
    sleep 1
done
apply
pactl subscribe 2>/dev/null | while read -r line; do
    case $line in
        # 'new': the graph was recreated (params reset to flat defaults) -
        # clear the cache so the contour is re-applied even at the same volume
        *"'new' on sink"*)    LAST=""; apply ;;
        *"'change' on sink"*) apply ;;
    esac
done
# the subscribe pipe only ends when the audio server went away; exit dirty
# so systemd's Restart policy re-runs us (the wait-for-sink loop above then
# handles the server coming back)
exit 1
