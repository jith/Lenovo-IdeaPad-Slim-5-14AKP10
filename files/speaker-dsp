#!/bin/sh
# Engage or bypass the 14-stage chain on the built-in speaker. No sudo is
# required when run as the desktop user.
#
#   speaker-dsp on      the chain processes, and the built-in speaker is
#                       selected if something else was
#   speaker-dsp off     bypass it IN PLACE -- same output, same slider, same
#                       level. Nothing about the routing changes
#   speaker-dsp ab      toggle between the two
#   speaker-dsp status  which one is live, and every volume that can rot
#   speaker-dsp unity   put every gain below the DSP back to 100%
#
# 'off' used to make the raw hardware sink the default. That could never work:
# hide-speaker-tuning.lua hides that sink from GNOME and WirePlumber will not
# default to a hidden sink, so the switch failed silently for weeks and then
# loudly for two days. The bypass now lives INSIDE the graph, at s14byp. See
# README, "speaker-dsp off bypasses in place".

if [ "$(id -u)" = "0" ] && [ -n "${SUDO_UID:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

DSP=effect_input.speaker-tuning
RAW=alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink

# Bypass is a live control change, so it leaves no trace in any config file and
# does not survive a restart -- the graph comes back tuned, which is the state
# the config file describes. Recorded here so status can report it.
STATE_DIR=${XDG_RUNTIME_DIR:-/tmp}
BYPASS_FLAG=$STATE_DIR/speaker-dsp.bypassed

# The chain is deliberately left hot: stage 13's comment records the tuned path
# as 5.63 LU above raw at the shipped settings. So bypassing is a real drop in
# level, and that is the tuning's own decision, not this script's. Said out loud
# on 'off' rather than silently corrected, because correcting it here would put
# a gain nobody measured into the comparison the bypass exists to make honest.
HOT_LU=5.63

# 'off' and 'ab' mean "bypass the DSP on what I am listening to". When the
# active output is an external device -- a Bluetooth speaker, earbuds,
# headphones, a USB speaker -- that is external-dsp's job. Without this,
# 'speaker-dsp off' moved the sound to the built-in speaker, which is a
# different physical device and never what was meant.
#
# External is now recognised by the default sink being a real device that is not
# the built-in speaker. It used to be recognised by the default sink being
# effect_input.external-tuning, and that sink no longer exists: the chains are
# hidden from GNOME and the DEVICE is what gets selected, with the chain spliced
# in behind it by 52-external-target.lua. Left as it was, this test never fired,
# so 'speaker-dsp off' on the earbuds silently bypassed the internal chain
# instead of the external one.
external_is_active() {
    case "$(pactl get-default-sink 2>/dev/null)" in
        "$RAW") return 1 ;;
        alsa_output*|bluez_output*) ;;
        *) return 1 ;;
    esac
    command -v external-dsp >/dev/null 2>&1
}

# The built-in speaker and the headphone jack share one card and cannot both be
# active: plugging headphones switches it to a UCM profile where
# HiFi__Speaker__sink does not exist at all.
#
# That matters because the 14-stage chain is a correction for ONE measured
# driver -- a Linkwitz transform for its Fs and Q, a notch at its 761 Hz
# resonance, harmonics synthesised to stand in for bass it cannot radiate -- and
# PipeWire routes a chain whose target has vanished to the default sink instead.
# So selecting it with headphones plugged puts the speaker's correction into the
# headphones, which is damage rather than tuning. Found 21 Aug 2026 while
# tracking down why the jack did not appear in GNOME.
speaker_present() {
    pactl list sinks short 2>/dev/null | awk '{print $2}' | grep -qx "$RAW"
}

usage() {
    echo "usage: speaker-dsp {on|off|ab|status|unity}" >&2
    echo "  on      Speaker (Tuning), the 14-stage filter chain" >&2
    echo "  off     bypass it in place -- same output, same level" >&2
    echo "  ab      toggle between them" >&2
    echo "  status  which one is currently the default output" >&2
    echo "  unity   put every gain below the DSP back to 100%" >&2
    exit 2
}

# The card's own mixer. These sit BELOW PipeWire -- below even the raw sink's
# volume, and far below the monitor tap every tool in tools/ captures from --
# so an attenuation here is invisible to every measurement in this repo while
# quietly making the speakers quieter than the chain assumes. There are three
# of them and any one will do it.
ALSA_CARD=1
ALSA_CTLS="Master Speaker PCM"

alsa_pct() {
    amixer -c "$ALSA_CARD" sget "$1" 2>/dev/null \
        | awk -F'[][]' '/Playback [0-9]+ \[/ { print $2; exit }' | tr -d '%'
}

warn_alsa_volume() {
    for _c in $ALSA_CTLS; do
        _p=$(alsa_pct "$_c")
        [ -n "$_p" ] || continue
        [ "$_p" = "100" ] && continue
        echo "note: ALSA '$_c' on card $ALSA_CARD is at ${_p}%. This is below"
        echo "      PipeWire, so nothing in tools/ can see it. 'speaker-dsp unity'"
        echo "      restores it."
    done
}

# Volume as a percentage, read from the first channel; both are kept equal.
volume_pct() {
    pactl get-sink-volume "$1" 2>/dev/null \
        | awk -F'/' '/Volume:/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

# The filter-chain's own node id, which is what pw-cli set-param addresses. It
# is not stable across a PipeWire restart, so look it up every time rather than
# caching it anywhere.
chain_id() {
    pactl list sinks short 2>/dev/null | awk -v n="$DSP" '$2 == n { print $1; exit }'
}

# Every graph control's NAME is in the sink node's Props and always readable.
# Its VALUE is only there while the sink is RUNNING: a SUSPENDED filter-chain
# reports all 1345 of its controls as 0.0, which looks exactly like a graph that
# lost its settings and is not one. So names are for checking what the graph
# HAS, values only for checking what it is SET TO, and only while it plays.
graph_props() {
    pw-dump "$1" 2>/dev/null | python3 -c "
import json, sys
for o in json.load(sys.stdin):
    for blk in ((o.get('info') or {}).get('params') or {}).get('Props') or []:
        p = blk.get('params')
        if isinstance(p, list) and len(p) > 100:
            for i in range(0, len(p), 2):
                print('%s\t%s' % (p[i], p[i + 1]))
"
}

graph_control() {
    graph_props "$1" | awk -F'\t' -v k="$2" '$1 == k { print $2; exit }'
}

# Does the RUNNING graph actually have the bypass? Worth asking, because
# pw-cli set-param EXITS 0 for a control that does not exist and for a node id
# that does not exist -- it reports nothing at all, ever. That is the same shape
# of lie as pactl set-default-sink, which is what cost this script two weeks of
# printing "RAW SPEAKER" while the chain went on processing. Checking the file
# on disk would not do: the failure that matters is a config installed without a
# PipeWire restart, where the file has s14byp and the live graph does not.
has_bypass() {
    graph_props "$1" | grep -q '^s14byp_l:Gain 1	'
}

sink_running() {
    pactl list sinks short 2>/dev/null \
        | awk -v n="$DSP" '$2 == n { print $NF; exit }' | grep -qx RUNNING
}

# THE BYPASS. s14byp is a two-input mixer at the very end of the graph: In 1 is
# the chain, In 2 is the untouched input tapped at s0in, ahead of stage 0. One
# gain pair decides which one is heard, and at either endpoint the other path
# contributes exactly nothing -- so 'off' is the raw signal, not an
# approximation of it.
#
# This replaced switching the default sink to the raw hardware, which could not
# work: hide-speaker-tuning.lua hides that sink from GNOME and WirePlumber will
# not default to a hidden sink, so 'off' reported success for weeks while the
# chain went on processing. See README, "A hidden sink must never be the
# default", and external-dsp, which was fixed the same way first.
#
# Not neutralised stage by stage, the way external-dsp does it: stage 2 is
# bq_raw and its coefficients cannot be set live without risking a half-applied
# unstable biquad. A crossfade needs no stage to be neutral, so it also bypasses
# any stage added later without this function being touched.
#
# The outgoing path is closed BEFORE the incoming one is opened. The two orders
# fail differently and both are sub-buffer: closing first is a moment of
# silence, opening first is a moment of both paths summed -- and s12brick runs
# 1 ms of lookahead, so summing them combs. Take the dropout.
set_bypass() {
    _id=$(chain_id)
    [ -n "$_id" ] || {
        echo "error: $DSP is not loaded, so there is" >&2
        echo "       no chain to bypass. Check 'pactl list sinks short'." >&2
        return 1
    }
    has_bypass "$_id" || {
        echo "error: the running graph has no s14byp, so it predates the" >&2
        echo "       in-place bypass and 'off' would do nothing whatever." >&2
        echo "       pw-cli would have reported success anyway, which is why" >&2
        echo "       this is checked rather than assumed." >&2
        echo >&2
        echo "       Install the current config and restart the session's audio:" >&2
        echo "         sudo sh install.sh install" >&2
        echo "         systemctl --user restart pipewire pipewire-pulse wireplumber" >&2
        return 1
    }
    if [ "$1" = "on" ]; then
        pw-cli set-param "$_id" Props '{ params = [
            "s14byp_l:Gain 1" 0.0 "s14byp_r:Gain 1" 0.0
            "s14byp_l:Gain 2" 1.0 "s14byp_r:Gain 2" 1.0 ] }' >/dev/null 2>&1
    else
        pw-cli set-param "$_id" Props '{ params = [
            "s14byp_l:Gain 2" 0.0 "s14byp_r:Gain 2" 0.0
            "s14byp_l:Gain 1" 1.0 "s14byp_r:Gain 1" 1.0 ] }' >/dev/null 2>&1
    fi
}

# Graph controls are write-only -- pw-dump reports no filter controls at all --
# so the live setting cannot be read back and this flag is the only record of
# it. It lives in the runtime dir, which is cleared on logout, and a PipeWire
# restart reloads the config and its tuned defaults; both leave the flag and
# the graph agreeing that the chain is processing. See README, "Setting controls
# on a live graph".
bypassed() { [ -f "$BYPASS_FLAG" ]; }

# GNOME shows one output entry, Speaker (Tuning), and its slider drives the
# virtual sink. In raw mode that sink is no longer in the audio path, so the
# slider goes inert until you switch back -- this warns rather than leaving
# you wondering. Carrying the level across the switch at least keeps the
# loudness continuous, which is what an A/B needs anyway.
# pactl set-default-sink EXITS 0 WHETHER OR NOT IT WORKED. WirePlumber owns the
# default and will refuse a sink its policy rejects -- notably a hidden one, and
# hide-speaker-tuning.lua hides the raw speaker. 'speaker-dsp off' printed
# "RAW SPEAKER" for weeks while the default stayed on Speaker (Tuning), because
# the && after pactl only ever saw a successful exit code.
#
# pactl is also the wrong thing to ASK: pipewire-pulse reports a default the
# client is allowed to see, so a hidden sink reads back as the visible one. Only
# pw-metadata is authoritative. See README, "A hidden sink must never be the
# default".
default_sink_is() {
    pw-metadata -n default 2>/dev/null \
        | awk -F'"' '/key:.default.audio.sink./ { print $(NF-1); exit }' \
        | grep -qx "$1"
}

# Set it, then check that it STAYS. Polling until it matches is the wrong shape
# here, because the failure mode is a TRANSIENT success: measured 4 Sep 2026,
# pactl's write lands and reads back correctly at 100 ms, and WirePlumber has
# reverted it by 200 ms. A poll-until-match saw the 100 ms reading and reported
# the switch as done. So: let it settle first, then require the value to hold
# across two reads.
set_default_checked() {
    pactl set-default-sink "$1" >/dev/null 2>&1
    sleep 0.6
    default_sink_is "$1" || return 1
    sleep 0.3
    default_sink_is "$1" || return 1
    return 0
}

# 'on' still has a sink to select, because it is also how you come back to the
# built-in speaker from an external device. 'off' has none: it changes nothing
# about where the audio goes.
select_tuned() {
    # The chain is tuned for the hardware at unity, and earlier versions of this
    # script carried the listening level onto the hardware sink on every 'off'.
    # Put it back, so a machine that ran one of those does not stay quiet.
    pactl set-sink-volume "$RAW" 100% >/dev/null 2>&1
    default_sink_is "$DSP" && return 0
    set_default_checked "$DSP" || {
        echo "error: could not make $DSP the default sink." >&2
        echo "       WirePlumber rejected it; check its policy and" >&2
        echo "       ~/.local/state/wireplumber/default-nodes." >&2
        return 1
    }
}

engage() {
    set_bypass off || return 1
    rm -f "$BYPASS_FLAG"
}

bypass() {
    set_bypass on || return 1
    : > "$BYPASS_FLAG"
}

# The level does not need carrying anywhere. GNOME's slider drives the DSP
# sink, that sink's volume is applied BEFORE the graph, and the bypass is inside
# the graph -- so tuned and raw are heard at the same setting by construction,
# and the slider stays live in both. That is the whole reason the old
# level-carrying arithmetic, its cubic-percentage conversion and its
# "the slider is inert now" warning are gone.
note_hot() {
    echo "note: the chain is deliberately hot -- stage 13 measures the tuned"
    echo "      path ${HOT_LU} LU above raw -- so bypassing IS quieter. That gap is"
    echo "      the tuning's, not the switch's; nothing here compensates it,"
    echo "      because a gain nobody measured would make the A/B dishonest."
}

# The hardware sink's volume is the only level in the system that nothing
# measures: it sits after the monitor tap every tool in tools/ captures from,
# so a chain tuned to the last tenth of a dB plays back quietly and every
# capture still reads correct. It drifts down on its own -- earlier versions of
# this script copied the virtual sink's level onto it on every 'off', volume
# keys move it, and pipewire has been seen coming back at 94% after a restart.
# Found there once, with
# 1.61 dB missing. Say so rather than let it rot silently.
warn_hardware_volume() {
    _hv=$(volume_pct "$RAW")
    [ -n "$_hv" ] || return 0
    [ "$_hv" = "100" ] && return 0
    # pactl's percentage is cubic, so quote the dB it prints alongside it --
    # 94% is 1.61 dB, and the percentage badly understates that.
    _hdb=$(pactl get-sink-volume "$RAW" 2>/dev/null \
        | awk 'NR==1{for(i=1;i<=NF;i++) if($i ~ /dB$/){print $(i-1)" "$i; exit}}')
    echo "note: the speakers are at ${_hv}% (${_hdb:-below 100%}), and the"
    echo "      chain is tuned for 100%. Nothing else will tell you --"
    echo "      captures are taken ahead of this control. Restore with:"
    echo "        pactl set-sink-volume $RAW 100%"
}

case "${1:-status}" in
    on|dsp|tuning)
        if ! speaker_present; then
            echo "the built-in speaker is not available: the onboard card is on its" >&2
            echo "headphone profile, so $RAW" >&2
            echo "does not exist. Selecting Speaker (Tuning) now would send the" >&2
            echo "speaker's own correction into the headphones." >&2
            echo "Unplug the jack, or use the headphones as they are:" >&2
            echo "  external-dsp status" >&2
            exit 1
        fi
        select_tuned || exit 1
        engage || exit 1
        echo "SPEAKER DSP - Speaker (Tuning), the 14-stage chain, is processing"
        ;;
    off|raw)
        if external_is_active; then
            echo "note: an external device is the active output, so bypassing THAT."
            echo "      Use 'speaker-dsp on' to move to the built-in speaker instead."
            exec external-dsp off
        fi
        bypass || exit 1
        echo "BYPASS - the chain is passing the input straight through, same"
        echo "         output, same slider, same level"
        note_hot
        ;;
    ab)
        if external_is_active; then
            echo "note: an external device is the active output, so toggling THAT."
            exec external-dsp ab
        fi
        if bypassed; then
            engage || exit 1
            echo "A/B -> SPEAKER DSP (14-stage chain)"
        else
            bypass || exit 1
            echo "A/B -> BYPASS (raw input)"
            note_hot
        fi
        ;;
    unity)
        for _c in $ALSA_CTLS; do
            amixer -c "$ALSA_CARD" sset "$_c" 100% >/dev/null 2>&1 && \
                echo "ALSA '$_c': 100%"
        done
        pactl set-sink-volume "$RAW" 100% 2>/dev/null && echo "$RAW: 100%"
        echo
        echo "Not touched: effect_input.speaker-tuning, currently $(volume_pct "$DSP")%."
        echo "That is GNOME's slider and the only volume you have left -- it is"
        echo "applied BEFORE the graph, so it changes the voicing as well as the"
        echo "level. Pinning it to 100% too would mean no volume control at all."
        echo "Run 'alsactl store' as root to make the ALSA settings survive a reboot."
        ;;
    status)
        current=$(pactl get-default-sink) || exit $?
        if ! speaker_present; then
            echo "state: the built-in speaker is not available -- headphones are in"
            echo "       the jack, and the onboard card cannot do both. Run"
            echo "       'external-dsp status' for what is actually playing."
            exit 0
        fi
        case "$current" in
            "$DSP"|"$RAW")
                # The flag is the record; the graph is the truth, but only
                # while it plays. When both are available and they disagree,
                # say so -- that means something set the gains behind this
                # script's back, or a PipeWire restart reverted them to the
                # config's tuned defaults while the flag survived in the
                # runtime dir.
                _live=
                if sink_running; then
                    _g2=$(graph_control "$(chain_id)" "s14byp_l:Gain 2")
                    case "$_g2" in
                        1|1.0|1.00*) _live=bypassed ;;
                        0|0.0|0.00*) _live=tuned ;;
                    esac
                fi
                if [ "$_live" = bypassed ] || { [ -z "$_live" ] && bypassed; }; then
                    echo "state: Speaker (Tuning) -- BYPASSED (raw input, ${HOT_LU} LU"
                    echo "       below the tuned path, which is the tuning's own offset)"
                else
                    echo "state: Speaker (Tuning), 14-stage chain"
                fi
                if [ -n "$_live" ]; then
                    if [ "$_live" = bypassed ] && ! bypassed; then
                        echo "note: read from the live graph, which does not agree with"
                        echo "      $BYPASS_FLAG. Run 'speaker-dsp on' or 'off' to settle it."
                    elif [ "$_live" = tuned ] && bypassed; then
                        echo "note: the graph is processing but this script recorded a"
                        echo "      bypass -- PipeWire has restarted since. The graph wins;"
                        echo "      run 'speaker-dsp off' again if you wanted raw."
                    fi
                else
                    echo "       (nothing is playing, so this is the recorded state, not a"
                    echo "        reading -- a suspended graph reports every control as 0.0)"
                fi ;;
            alsa_output*|bluez_output*)
                    echo "state: external device -- run 'external-dsp status'" ;;
            *) echo "state: other output ($current)" ;;
        esac
        warn_hardware_volume
        warn_alsa_volume
        for _c in $ALSA_CTLS; do echo "  ALSA $_c: $(alsa_pct "$_c")%"; done
        ;;
    *) usage ;;
esac
