#!/bin/sh
# speaker-dsp — switch between raw and tuned speaker output.
#   speaker-dsp on      -> "Speaker (Tuned)": measured EQ + psycho-bass +
#                          dynamics + volume-aware loudness contour.
#                          Keeps your current volume (the speaker-loudness
#                          service compensates the sink's steep taper).
#   speaker-dsp off     -> raw "Speaker": cleanest, normal hardware volume.
#   speaker-dsp status  -> show current state
# Installed system-wide at /usr/local/bin/speaker-dsp. No sudo needed to use.

if [ "$(id -u)" = "0" ] && [ -n "$SUDO_UID" ]; then
  export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

DSP="effect_input.speaker-tuning"
RAW="alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink"

case "$1" in
  on|dsp|tuned)
    # The DSP SINK's volume is left alone on purpose: forcing 100% there (old
    # behavior) could blast audio; low volumes are fine now - LV2 keeps
    # processing at any volume and the loudness service compensates the taper.
    #
    # The HARDWARE sink is different, and must be pinned to 0 dB (S0, 2026-08-02).
    # Both sinks share one hardware volume control, so a level left behind by
    # quiet listening on the raw sink silently attenuates the whole tuned path.
    # This is not a loudness change: the graph's -1 dBFS ceiling and the drive
    # setting already account for the amp sitting at 0 dB. The daemon re-pins on
    # every sink event; this makes it immediate on an explicit switch.
    pactl set-default-sink "$DSP" \
      && pactl set-sink-volume "$RAW" 100% >/dev/null 2>&1
    [ "$(pactl get-default-sink)" = "$DSP" ] \
      && echo "TUNED - Speaker (Tuned): EQ + bass + dynamics + loudness contour"
    ;;
  off|raw)
    pactl set-default-sink "$RAW" && echo "RAW - plain speaker, hardware volume"
    ;;
  status|*)
    cur=$(pactl get-default-sink)
    case "$cur" in
      "$DSP") echo "state: TUNED (Speaker (Tuned) is default)" ;;
      "$RAW") echo "state: RAW (plain speaker)" ;;
      *)      echo "state: other output ($cur)" ;;
    esac
    ;;
esac
