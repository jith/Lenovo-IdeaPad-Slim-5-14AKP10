#!/bin/sh
# Switch the default output between the tuned virtual speaker sink and the raw
# hardware speaker. No sudo is required when run as the desktop user.

if [ "$(id -u)" = "0" ] && [ -n "${SUDO_UID:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

DSP=effect_input.speaker-tuning
RAW=alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink

# Loudness trim for the raw path, in dB, from tools/loudness-match.sh.
# Attenuation only: the louder path is trimmed at its own output, never the
# quieter one boosted. When the tuned path is the louder one its trim belongs
# at stage 13 of the filter graph instead.
#
# -0.75 dB measured with stages 2 and 9 live, on the shipped pink noise.
# Two contributions: the Linkwitz transform's cut around the 761 Hz resonance
# (-0.13) and bass mono removing side energy below 300 Hz (-0.62).
#
# Pink noise has fully decorrelated channels, which is the worst case for bass
# mono. On material whose bass is already mono, as most records are cut, the
# same measurement gives -0.52. The 0.23 dB between them is well under
# audibility, but the honest figure is the one measured on what you actually
# listen to: drop a few tracks into tests/material/ and re-run
# tools/loudness-match.sh against them.
RAW_TRIM_DB=${SPEAKER_DSP_RAW_TRIM_DB:--0.75}

usage() {
    echo "usage: speaker-dsp {on|off|ab|status}" >&2
    echo "  on      Speaker (Tuning), the 13-stage filter chain" >&2
    echo "  off     raw hardware speaker" >&2
    echo "  ab      toggle between them, carrying the level across" >&2
    echo "  status  which one is currently the default output" >&2
    exit 2
}

# Volume as a percentage, read from the first channel; both are kept equal.
# Percentages, not dB: pactl reads a leading '-' as a RELATIVE adjustment, so
# passing a negative dB figure subtracts it instead of setting it, and the
# level halves on every toggle.
volume_pct() {
    pactl get-sink-volume "$1" 2>/dev/null \
        | awk -F'/' '/Volume:/ { gsub(/[^0-9]/, "", $2); print $2; exit }'
}

# Carry a level from one sink to another, applying the trim in dB.
# pactl's percentage is a cubic scale, so a linear gain of g scales the
# percentage by g^(1/3) -- hence 10^(dB/60) rather than 10^(dB/20).
carry_volume() {
    _pct=$(volume_pct "$1")
    [ -n "$_pct" ] || return 0
    pactl set-sink-volume "$2" \
        "$(awk -v p="$_pct" -v t="$3" 'BEGIN{
            v = p * (10 ^ (t / 60)); if (v > 100) v = 100
            printf "%.0f", v }')%" >/dev/null 2>&1
}

# GNOME shows one output entry, Speaker (Tuning), and its slider drives the
# virtual sink. In raw mode that sink is no longer in the audio path, so the
# slider goes inert until you switch back -- this warns rather than leaving
# you wondering. Carrying the level across the switch at least keeps the
# loudness continuous, which is what an A/B needs anyway.
select_tuned() {
    carry_volume "$RAW" "$DSP" "$(awk -v t="$RAW_TRIM_DB" 'BEGIN{print -t}')"
    pactl set-default-sink "$DSP"
}

select_raw() {
    carry_volume "$DSP" "$RAW" "$RAW_TRIM_DB"
    pactl set-default-sink "$RAW"
}

warn_slider() {
    echo "note: GNOME's volume slider drives $DSP, which is not in the"
    echo "      path while raw is selected. Use 'speaker-dsp on', or set the"
    echo "      level with: pactl set-sink-volume $RAW <n>%"
}

case "${1:-status}" in
    on|dsp|tuning)
        select_tuned && echo "SPEAKER DSP - Speaker (Tuning) is the default output"
        ;;
    off|raw)
        select_raw && {
            echo "RAW SPEAKER - the hardware speaker is the default output"
            warn_slider
        }
        ;;
    ab)
        current=$(pactl get-default-sink) || exit $?
        if [ "$current" = "$DSP" ]; then
            select_raw && { echo "A/B -> RAW SPEAKER"; warn_slider; }
        else
            select_tuned && echo "A/B -> SPEAKER DSP (Speaker (Tuning))"
        fi
        ;;
    status)
        current=$(pactl get-default-sink) || exit $?
        case "$current" in
            "$DSP") echo "state: Speaker (Tuning), 13-stage chain" ;;
            "$RAW") echo "state: raw hardware speaker"; warn_slider ;;
            *) echo "state: other output ($current)" ;;
        esac
        ;;
    *) usage ;;
esac
