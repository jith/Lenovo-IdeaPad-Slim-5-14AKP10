#!/bin/sh
# Switch the default output between the starter's virtual speaker sink and
# the raw hardware speaker. No sudo is required when run as the desktop user.

if [ "$(id -u)" = "0" ] && [ -n "${SUDO_UID:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$SUDO_UID"
fi

DSP=effect_input.speaker-tuning
RAW=alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink

case "${1:-status}" in
    on|dsp|tuning)
        pactl set-default-sink "$DSP" &&
            echo "SPEAKER DSP - Speaker (Tuning) is the default output"
        ;;
    off|raw)
        pactl set-default-sink "$RAW" &&
            echo "RAW SPEAKER - the hardware speaker is the default output"
        ;;
    status)
        current_sink=$(pactl get-default-sink) || exit $?
        case "$current_sink" in
            "$DSP") echo "state: Speaker (Tuning) (pass-through starter)" ;;
            "$RAW") echo "state: raw hardware speaker" ;;
            *) echo "state: other output ($current_sink)" ;;
        esac
        ;;
    *)
        echo "usage: speaker-dsp {on|off|status}" >&2
        exit 2
        ;;
esac
