[Unit]
Description=Volume-aware loudness contour for the speaker DSP
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service

[Service]
ExecStart=/usr/local/bin/speaker-loudness-follow
# always: pactl subscribe ends CLEANLY (exit 0) whenever pipewire-pulse
# restarts, and on-failure would leave the daemon dead (measured 2026-07-16)
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
