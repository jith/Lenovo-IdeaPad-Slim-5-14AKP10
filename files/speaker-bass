#!/usr/bin/env python3
"""Switch the built-in speaker bass enhancement and remember the setting."""
import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
from tempfile import NamedTemporaryFile
import time

SINK = "effect_input.speaker-tuning"
SPEAKERS = "alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink"
STRENGTH = "trialbass:Strength"
ON = 0.055
STATE = (Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
         / "speaker-dsp/bass")


def command(*args):
    return subprocess.check_output(args, text=True, timeout=5).strip()


def read_controls():
    for node in json.loads(command("pw-dump", SINK)):
        info = node.get("info", {})
        if info.get("props", {}).get("node.name") != SINK:
            continue
        for block in info.get("params", {}).get("Props", []):
            params = block.get("params", [])
            if STRENGTH in params:
                return node["id"], info["state"], dict(zip(params[::2], params[1::2]))
    raise RuntimeError("The running speaker profile has no bass control.")


def write_strength(node, strength):
    props = json.dumps({"params": [STRENGTH, strength]})
    command("pw-cli", "set-param", str(node), "Props", props)


@contextmanager
def running_graph():
    if command("pactl", "get-default-sink") != SINK:
        raise RuntimeError("Select Speaker (Tuning) to use the built-in speaker switch.")
    if SPEAKERS not in {line.split()[1] for line in command("pactl", "list", "short", "sinks").splitlines()}:
        raise RuntimeError("The built-in speakers are unavailable.")

    # Filter-chain reports zeros for suspended controls. Use digital silence
    # while reading back the live state, even when no music is playing.
    with open("/dev/zero", "rb") as silence:
        player = subprocess.Popen(
            ["pw-play", "--properties", "{ node.dont-fallback = true node.dont-move = true }",
             "--target", SINK,
             "--raw", "--channels", "2", "--rate", "48000", "--format", "s16", "-"],
            stdin=silence, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        try:
            for _ in range(40):
                node, state, controls = read_controls()
                if state == "running":
                    yield node, controls
                    return
                if player.poll() is not None:
                    break
                time.sleep(.05)
            raise RuntimeError("The speaker graph did not wake for verification.")
        finally:
            player.terminate()
            player.wait(timeout=3)


def set_strength(node, strength):
    write_strength(node, strength)
    for _ in range(20):
        current, state, values = read_controls()
        if current != node:
            raise RuntimeError("The speaker graph restarted during the switch.")
        if state == "running" and abs(values[STRENGTH] - strength) < 1e-6:
            return
        time.sleep(.04)
    raise RuntimeError("The speaker graph did not confirm the bass setting.")


def save(enabled):
    STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with NamedTemporaryFile(mode="w", dir=STATE.parent, delete=False) as temp:
        staged = Path(temp.name)
        try:
            temp.write("on\n" if enabled else "off\n")
            temp.flush()
            os.fsync(temp.fileno())
            staged.replace(STATE)
        finally:
            staged.unlink(missing_ok=True)


def restore():
    try:
        saved = STATE.read_text().strip()
    except FileNotFoundError:
        return
    if saved not in ("on", "off"):
        raise RuntimeError(f"Invalid bass setting in {STATE}. Expected on or off.")

    # context.exec may run before the node is published. The filter stores a
    # control written while suspended and applies it when playback starts.
    # Its readback is reliable only once running. No output needs to be woken.
    for attempt in range(25):
        try:
            node, state, _ = read_controls()
            break
        except (RuntimeError, subprocess.CalledProcessError):
            if attempt == 24:
                raise
            time.sleep(.1)
    strength = ON if saved == "on" else 0.0
    write_strength(node, strength)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", nargs="?", default="toggle",
                        choices=("on", "off", "toggle", "status", "restore"))
    action = parser.parse_args().action
    if action == "restore":
        # A daemon launched with a private config may pass these to its
        # children. pw-cli and pw-dump must load their own client configs.
        os.environ.pop("PIPEWIRE_CONFIG_NAME", None)
        os.environ.pop("PIPEWIRE_CONFIG_DIR", None)

    lock_path = Path(os.environ["XDG_RUNTIME_DIR"]) / "speaker-bass.lock"
    with lock_path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if action == "restore":
            restore()
            return
        with running_graph() as (node, controls):
            if any(controls[f"s14byp_{ch}:Gain 2"] > .5 for ch in "lr"):
                raise RuntimeError("Speaker tuning is bypassed. Run speaker-dsp on to hear the bass effect.")
            previous = controls[STRENGTH]
            enabled = previous > 1e-6
            if action != "status":
                enabled = not enabled if action == "toggle" else action == "on"
                set_strength(node, ON if enabled else 0.0)
                try:
                    save(enabled)
                except OSError:
                    set_strength(node, previous)
                    raise
            print("Speaker bass ON" if enabled else "Speaker bass OFF")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        sys.exit(str(error))
