#!/bin/sh
# Post-graph volume for the levelled speaker chain.
#
#   spk-vol            show current levels
#   spk-vol up | down  step by $STEP  (bound to the volume keys)
#   spk-vol 76         set an absolute percentage
#
# WHY THIS EXISTS. The filter chain carries a loudness leveller, and a sink's
# own volume is applied BEFORE the graph. So a normal volume change is seen by
# the leveller and undone: measured on -14 LUFS programme, moving the chain
# sink from 100% to 76% changed the output by 0.0 dB. Setting the level on the
# DEVICE instead puts it downstream of everything, where it is a plain
# attenuation the leveller cannot see -- verified identical LUFS and dBTP at
# 100% and 76% on a hardware capture.
#
# The chain sink is therefore pinned at unity on every call. Do not "fix" that
# by removing the pin; it is the whole mechanism.
STEP=5
DEV=alsa_output.pci-0000_04_00.6.HiFi__Speaker__sink

# Which sink actually carries the level. A filter chain never does -- its
# volume lands ahead of the DSP -- so resolve past it to the device. Anything
# that is not one of our internal chains (Bluetooth, a USB speaker) is its own
# device and takes the level directly.
default=$(pactl get-default-sink 2>/dev/null)
case "$default" in
    effect_input.speaker-levelled|effect_input.speaker-tuning)
        target=$DEV
        pactl set-sink-volume "$default" 100% 2>/dev/null ;;
    *)  target=$default ;;
esac
[ -n "$target" ] || exit 1

cur=$(pactl get-sink-volume "$target" 2>/dev/null | head -1 | grep -oE '[0-9]+%' | head -1 | tr -d '%')
[ -n "$cur" ] || exit 1

case "${1:-}" in
    --bind-keys)
        # The volume keys must drive this, not the sink. GNOME's own bindings
        # are cleared off the bare keys and left on the <Ctrl> variants as a
        # way back to the old pre-graph behaviour.
        B=org.gnome.settings-daemon.plugins.media-keys
        P=/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings
        gsettings set $B volume-up-static   "['<Ctrl>XF86AudioRaiseVolume']"
        gsettings set $B volume-down-static "['<Ctrl>XF86AudioLowerVolume']"
        gsettings set $B custom-keybindings "['$P/custom0/', '$P/custom1/']"
        for i in 0 1; do
            S="$B.custom-keybinding:$P/custom$i/"
            if [ "$i" = 0 ]; then n='Speaker volume up';   c='up'
            else                  n='Speaker volume down'; c='down'; fi
            k=$([ "$i" = 0 ] && echo XF86AudioRaiseVolume || echo XF86AudioLowerVolume)
            gsettings set "$S" name "$n"
            gsettings set "$S" command "$0 $c"
            gsettings set "$S" binding "$k"
        done
        echo "volume keys bound to $0"; exit 0 ;;
    "")   printf 'output %s  %s%%\n' "$target" "$cur"; exit 0 ;;
    up)   new=$((cur + STEP)); [ "$new" -gt 100 ] && new=100 ;;
    down) new=$((cur - STEP)); [ "$new" -lt 0 ] && new=0 ;;
    *)    new=$1 ;;
esac

pactl set-sink-volume "$target" "$new%" || exit 1
# The volume OSD only follows the default sink, which is deliberately not the
# one being changed, so there would otherwise be no feedback at all.
command -v notify-send >/dev/null 2>&1 &&
    notify-send -h int:value:"$new" -h string:x-canonical-private-synchronous:spk-vol \
                -i audio-volume-high "Speaker $new%" 2>/dev/null
printf '%s%%\n' "$new"
