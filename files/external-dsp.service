# Reassert the External (Tuning) gain structure after PipeWire starts.
#
# WirePlumber restores a remembered volume for every device. After a restart
# that left the pre-graph sink at 38% -- which switches the DSP off, since the
# volume is applied before the graph -- and the device at 100%, which on a loud
# speaker is a hazard and is past the configured cap. Both are silent failures:
# nothing reports either state.
#
#   systemctl --user enable --now external-dsp.service
[Unit]
Description=Reassert External (Tuning) gain structure
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=oneshot
# WirePlumber restores device volumes a moment after the nodes appear, so
# reasserting immediately would be overwritten by the thing it is correcting.
ExecStartPre=/bin/sleep 5
ExecStart=/usr/local/bin/external-dsp startup
RemainAfterExit=no

[Install]
WantedBy=default.target
